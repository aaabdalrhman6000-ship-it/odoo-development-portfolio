<odoo>
    <record id="order_cancel_wizard_form_view" model="ir.ui.view">
        <field name="name">som.order.cancel.wizard.form</field>
        <field name="model">som.order.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Order">
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="cancel_reason"
                           placeholder="Enter the reason for cancellation"/>
                </group>
                <footer>
                    <button string="Confirm"
                            type="object"
                            name="action_cancel_order"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>