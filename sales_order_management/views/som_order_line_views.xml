<odoo>

    <record id="som_order_line_tree_view" model="ir.ui.view">
        <field name="name">som order line tree view</field>
        <field name="model">som.order.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="order_id"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="quantity"/>
                <field name="price_unit"/>
                <field name="discount"/>
                <field name="tax_ids"/>
                <field name="subtotal"/>
                <field name="currency_id"/>
            </tree>
        </field>
    </record>

    <record id="som_order_line_view_view" model="ir.ui.view">
        <field name="name">Som order view view</field>
        <field name="model">som.order.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="order_id"/>
                        <field name="product_id"/>
                        <field name="name"/>
                        <field name="quantity"/>
                        <field name="price_unit"/>
                        <field name="discount"/>
                        <field name="tax_ids" widget="many2many_tags"/>
                        <field name="subtotal"/>
                        <field name="currency_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="som_order_line_action" model="ir.actions.act_window">
        <field name="name">Order Line</field>
        <field name="res_model">som.order.line</field>
    </record>

</odoo>