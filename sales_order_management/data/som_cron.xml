<odoo>
    <record id="som_order_cron" model="ir.cron">
        <field name="name">Sales Order: Cancel Expired Quotations</field>
        <field name="model_id" ref="model_som_order"/>
        <field name="state">code</field>
        <field name="code">model.check_cancelled_orders()</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>