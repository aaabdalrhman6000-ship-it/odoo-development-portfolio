<odoo>

    <record id="vehicle_tree_view" model="ir.ui.view">
        <field name="name">Vehicle tree view</field>
        <field name="model">repair.vehicle</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="license_plate"/>
                <field name="brand"/>
                <field name="model_year"/>
                <field name="color"/>
                <field name="vin"/>
                <field name="active"/>
                <field name="customer_id"/>
            </tree>
        </field>
    </record>

    <record id="vehicle_form_view" model="ir.ui.view">
        <field name="name">Vehicle form view</field>
        <field name="model">repair.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="license_plate"/>
                        <field name="brand"/>
                        <field name="model_year"/>
                        <field name="color"/>
                        <field name="vin"/>
                        <field name="active"/>
                        <field name="customer_id"/>
                    </group>
                    <notebook>
                        <page string="Repair Orders">
                            <field name="repair_order_ids">
                                <tree>
                                    <field name="ref"/>
                                    <field name="order_date"/>
                                    <field name="expected_completion_date"/>
                                    <field name="state"/>
                                    <field name="total_amount"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vehicle_action" model="ir.actions.act_window">
        <field name="name">Vehicle</field>
        <field name="res_model">repair.vehicle</field>
    </record>

</odoo>