<odoo>

    <record id="part_tree_view" model="ir.ui.view">
        <field name="name">Part tree view</field>
        <field name="model">repair.part</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="part_number"/>
                <field name="description"/>
                <field name="price"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="part_form_view" model="ir.ui.view">
        <field name="name">Part form view</field>
        <field name="model">repair.part</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="part_number"/>
                        <field name="description"/>
                        <field name="price"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="part_action" model="ir.actions.act_window">
        <field name="name">Repair Part</field>
        <field name="res_model">repair.part</field>
    </record>

</odoo>