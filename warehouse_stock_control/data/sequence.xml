<odoo>

    <!-- Stock Picking Sequence -->
    <record id="picking_sequence" model="ir.sequence">
        <field name="name">Picking Sequence</field>
        <field name="code">picking_seq</field>
        <field name="prefix">PK/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <!-- Stock Adjustment Sequence -->
    <record id="adj_sequence" model="ir.sequence">
        <field name="name">Adjustment Sequence</field>
        <field name="code">adjustment_seq</field>
        <field name="prefix">ADJ/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

</odoo>