<odoo>

    <record id="location_tree_view" model="ir.ui.view">
        <field name="name">wsc.location.tree</field>
        <field name="model">wsc.location</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="complete_name"/>
                <field name="parent_id"/>
                <field name="warehouse_id"/>
                <field name="location_type"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="location_view_view" model="ir.ui.view">
        <field name="name">wsc.location.form</field>
        <field name="model">wsc.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="parent_id"/>
                            <field name="complete_name" readonly="1"/>
                        </group>

                        <group>
                            <field name="warehouse_id"/>
                            <field name="location_type"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Child Locations">
                            <field name="child_ids" context="{'default_warehouse_id': warehouse_id}">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="complete_name" readonly="1"/>
                                    <field name="parent_id" readonly="1"/>
                                    <field name="warehouse_id" readonly="1"/>
                                    <field name="location_type"/>
                                    <field name="active"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="location_action" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">wsc.location</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
