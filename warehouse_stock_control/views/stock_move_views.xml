<odoo>

    <record id="move_tree_view" model="ir.ui.view">
        <field name="name">Move Tree View</field>
        <field name="model">wsc.stock.move</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="picking_id"/>
                <field name="product_id"/>
                <field name="product_uom_qty"/>
                <field name="location_id"/>
                <field name="location_dest_id"/>
                <field name="state"/>
                <field name="date"/>
                <field name="quantity_done"/>
            </tree>
        </field>
    </record>

    <record id="move_form_view" model="ir.ui.view">
        <field name="name">Move Form View</field>
        <field name="model">wsc.stock.move</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="picking_id"/>
                        <field name="product_id"/>
                        <field name="product_uom_qty"/>
                        <field name="location_id"/>
                        <field name="location_dest_id"/>
                        <field name="state"/>
                        <field name="date"/>
                        <field name="quantity_done"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="move_search_view" model="ir.ui.view">
        <field name="name">Search View</field>
        <field name="model">wsc.stock.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="picking_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="confirm" string="Confirm" domain="[('state','=','confirmed')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="cancel" string="Cancel" domain="[('state','=','cancelled')]"/>
                <filter name="product" string="Product" context="{'group_by':'product_id'}"/>
                <filter name="picking" string="Picking" context="{'group_by':'picking_id'}"/>
            </search>
        </field>
    </record>

    <record id="move_action" model="ir.actions.act_window">
        <field name="name">Stock Move</field>
        <field name="res_model">wsc.stock.move</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>