<odoo>

    <record id="warehouse_tree_view" model="ir.ui.view">
        <field name="name">WareHouse Tree</field>
        <field name="model">wsc.warehouse</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="address"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="warehouse_view_view" model="ir.ui.view">
        <field name="name">WareHouse View</field>
        <field name="model">wsc.warehouse</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="address"/>
                        <field name="active"/>
                        <field name="manager_id"/>
                        <field name="stock_location_id"/>
                    </group>
                    <notebook>
                        <page string="Location">
                            <field name="location_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="complete_name"/>
                                    <field name="warehouse_id"/>
                                    <field name="location_type"/>
                                    <field name="active"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="warehouse_action" model="ir.actions.act_window">
        <field name="name">WareHouse</field>
        <field name="res_model">wsc.warehouse</field>
    </record>

</odoo>