    <odoo>

        <record id="picking_tree_view" model="ir.ui.view">
            <field name="name">Picking Tree</field>
            <field name="model">wsc.stock.picking</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="ref"/>
                    <field name="operation_type"/>
                    <field name="scheduled_date"/>
                    <field name="date_done"/>
                    <field name="partner_id"/>
                    <field name="warehouse_id"/>
                    <field name="state"/>
                    <field name="user_id"/>
                </tree>
            </field>
        </record>

        <record id="picking_view_view" model="ir.ui.view">
            <field name="name">Picking View</field>
            <field name="model">wsc.stock.picking</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_confirm"
                                string="Confirm"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'draft'"/>

                        <button name="action_done"
                                string="Done"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'confirmed'"/>

                        <button name="action_cancel"
                                string="Cancel"
                                type="object"
                                class="btn-secondary"
                                invisible="state not in ('draft', 'confirmed')"/>

                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="ref"/>
                            <field name="operation_type"/>
                            <field name="scheduled_date"/>
                            <field name="date_done"/>
                            <field name="partner_id"/>
                            <field name="warehouse_id"/>
                            <field name="location_id"/>
                            <field name="location_dest_id"/>
                            <field name="user_id"/>
                            <field name="total_quantity"/>
                        </group>
                        <notebook>
                            <page string="Move">
                                <field name="move_ids">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                        <field name="product_id"/>
                                        <field name="product_uom_qty"/>
                                        <field name="quantity_done"/>
                                        <field name="location_id"/>
                                        <field name="location_dest_id"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="picking_action" model="ir.actions.act_window">
            <field name="name">Picking</field>
            <field name="res_model">wsc.stock.picking</field>
        </record>

    </odoo>