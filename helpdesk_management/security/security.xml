<odoo>

    <record id="helpdesk_category" model="ir.module.category">
        <field name="name">Help Desk</field>
    </record>

    <record id="helpdesk_user" model="res.groups">
        <field name="name">Helpdesk User</field>
        <field name="category_id" ref="helpdesk_system.helpdesk_category"/>
    </record>

    <record id="helpdesk_manager" model="res.groups">
        <field name="name">Helpdesk Manager</field>
        <field name="category_id" ref="helpdesk_system.helpdesk_category"/>
        <field name="implied_ids" eval="[(4, ref('helpdesk_system.helpdesk_user'))]"/>
    </record>

</odoo>