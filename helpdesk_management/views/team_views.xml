<odoo>

    <record id="team_tree_view" model="ir.ui.view">
        <field name="name">Team tree view</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
                <field name="leader_id"/>
                <field name="member_ids"/>
                <field name="ticket_ids"/>
                <field name="ticket_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="team_form_view" model="ir.ui.view">
        <field name="name">Team form view</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="leader_id"/>
                        <field name="member_ids" widget="many2many_tags"/>
                        <field name="ticket_ids" widget="many2many_tags"/>
                        <field name="ticket_count"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="team_action" model="ir.actions.act_window">
        <field name="name">Team</field>
        <field name="res_model">helpdesk.team</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>