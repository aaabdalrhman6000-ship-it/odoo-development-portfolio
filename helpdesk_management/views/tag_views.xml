<odoo>

    <record id="tag_tree_view" model="ir.ui.view">
        <field name="name">Tag tree view</field>
        <field name="model">helpdesk.tag</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="color"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="tag_form_view" model="ir.ui.view">
        <field name="name">Tag form view</field>
        <field name="model">helpdesk.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="tag_action" model="ir.actions.act_window">
        <field name="name">Tag</field>
        <field name="res_model">helpdesk.tag</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>